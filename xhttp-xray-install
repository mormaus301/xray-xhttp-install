#!/bin/bash
echo -e "\e[1;32mWill be install vless-xhttp-reality and vless-grpc-reality\e[0m"
sleep 3
apt update && apt upgrade -y
apt install qrencode curl jq -y

# Enable bbr and tune TCP buffers
mkdir -p /etc/sysctl.d
modprobe tcp_bbr 2>/dev/null || true
cat << 'EOF' > /etc/sysctl.d/99-xray-bbr.conf
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
net.core.rmem_max = 16777216
net.core.wmem_max = 16777216
net.ipv4.tcp_rmem = 4096 87380 16777216
net.ipv4.tcp_wmem = 4096 65536 16777216
EOF
sysctl --system >/dev/null 2>&1 || sysctl -p /etc/sysctl.d/99-xray-bbr.conf >/dev/null 2>&1 || true
echo "bbr and tcp buffers have been configured"

# Xray-core install
bash -c "$(curl -4 -L https://github.com/XTLS/Xray-install/raw/main/install-release.sh)" @ install
[ -f /usr/local/etc/xray/.keys ] && rm /usr/local/etc/xray/.keys
touch /usr/local/etc/xray/.keys
echo "shortsid: $(openssl rand -hex 8)" >> /usr/local/etc/xray/.keys
echo "uuid: $(xray uuid)" >> /usr/local/etc/xray/.keys
xray x25519 >> /usr/local/etc/xray/.keys

export uuid=$(cat /usr/local/etc/xray/.keys | awk -F': ' '/uuid/ {print $2}')
export privatkey=$(cat /usr/local/etc/xray/.keys | awk -F': ' '/PrivateKey/ {print $2}')
export shortsid=$(cat /usr/local/etc/xray/.keys | awk -F': ' '/shortsid/ {print $2}')

# Create config file
touch /usr/local/etc/xray/config.json
cat << EOF > /usr/local/etc/xray/config.json
{
  "log": {
    "loglevel": "warning"
  },
  "routing": {
    "domainMatcher": "hybrid",
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "domain": [
          "geosite:category-ads-all",
          "geosite:category-ru",
          "geosite:private",
          "domain:ru",
          "domain:su",
          "domain:xn--p1ai",
          "domain:xn--p1acf",
          "domain:vk.com",
          "domain:userapi.com",
          "domain:vk-cdn.net",
          "domain:vkuservideo.net",
          "domain:mycdn.me",
          "domain:vk-portal.net",
          "domain:yandex.com",
          "domain:yastatic.net",
          "domain:yandex.net",
          "domain:yandex.cloud",
          "domain:2gis.com",
          "domain:2gis.kz",
          "domain:2gis.ae",
          "domain:wbstatic.net",
          "domain:wildberries.by",
          "domain:ozon.travel",
          "domain:ozonusercontent.com",
          "domain:ozon.by",
          "domain:avito.st"
        ],
        "outboundTag": "block"
      },
      {
        "type": "field",
        "ip": [
          "geoip:cn",
          "geoip:ru",
          "geoip:private"
        ],
        "outboundTag": "block"
      }
    ]
  },
  "inbounds": [
    {
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "$uuid",
            "flow": ""
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "xhttpSettings": {
          "path": "/api/v3",
          "mode": "auto"
        },
        "security": "reality",
        "realitySettings": {
          "show": false,
          "target": "www.dropbox.com:443",
          "serverNames": [
            "www.dropbox.com"
          ],
          "privateKey": "$privatkey",
          "shortIds": [
            "$shortsid"
          ],
          "fingerprint": "firefox"
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "metadataOnly": false,
        "routeOnly": false
      }
    },
    {
      "port": 2083,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "$uuid",
            "flow": ""
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "grpc",
        "grpcSettings": {
          "serviceName": ""
        },
        "security": "reality",
        "realitySettings": {
          "show": false,
          "target": "exchange-l76.itxtech.surf:443",
          "serverNames": [
            "exchange-l76.itxtech.surf"
          ],
          "privateKey": "$privatkey",
          "shortIds": [
            "$shortsid"
          ],
          "fingerprint": "chrome"
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "metadataOnly": false,
        "routeOnly": false
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    }
  ]
}
EOF

# Compiling link
touch /usr/local/bin/link
cat << 'EOF' > /usr/local/bin/link
#!/bin/bash

# Сбор актуальных данных
ip=$(timeout 3 curl -4 -s icanhazip.com)
pbk=$(cat /usr/local/etc/xray/.keys | awk -F': ' '/Password/ {print $2}')

# VLESS XHTTP
port_xhttp=$(jq -r '.inbounds[0].port' /usr/local/etc/xray/config.json)
uuid=$(jq -r '.inbounds[0].settings.clients[0].id' /usr/local/etc/xray/config.json)
mode=$(jq -r '.inbounds[0].streamSettings.xhttpSettings.mode' /usr/local/etc/xray/config.json)
path=$(jq -r '.inbounds[0].streamSettings.xhttpSettings.path | @uri' /usr/local/etc/xray/config.json)
sni=$(jq -r '.inbounds[0].streamSettings.realitySettings.serverNames[0]' /usr/local/etc/xray/config.json)
sid=$(jq -r '.inbounds[0].streamSettings.realitySettings.shortIds[0]' /usr/local/etc/xray/config.json)
fp=$(jq -r '.inbounds[0].streamSettings.realitySettings.fingerprint' /usr/local/etc/xray/config.json)

# VLESS gRPC
port_grpc=$(jq -r '.inbounds[1].port' /usr/local/etc/xray/config.json)
uuid_grpc=$(jq -r '.inbounds[1].settings.clients[0].id' /usr/local/etc/xray/config.json)
service_name=$(jq -r '.inbounds[1].streamSettings.grpcSettings.serviceName | @uri' /usr/local/etc/xray/config.json)
sni_grpc=$(jq -r '.inbounds[1].streamSettings.realitySettings.serverNames[0]' /usr/local/etc/xray/config.json)
sid_grpc=$(jq -r '.inbounds[1].streamSettings.realitySettings.shortIds[0]' /usr/local/etc/xray/config.json)
fp_grpc=$(jq -r '.inbounds[1].streamSettings.realitySettings.fingerprint' /usr/local/etc/xray/config.json)

# Compiling vless-xhttp-reality and vless-grpc-reality configurations for output
xhttp_link="vless://$uuid@$ip:$port_xhttp?security=reality&path=$path&mode=$mode&sni=$sni&fp=$fp&pbk=$pbk&sid=$sid&spx=%2F&type=xhttp&encryption=none#💉 vless-xhttp"
grpc_link="vless://$uuid_grpc@$ip:$port_grpc?security=reality&serviceName=$service_name&mode=gun&sni=$sni_grpc&fp=$fp_grpc&pbk=$pbk&sid=$sid_grpc&spx=%2F&type=grpc&encryption=none#📐 vless-grpc"

# Output of final data / Вывод итоговых данных
echo -e "\e[1;32mСсылки для подключения:\e[0m"
echo -e "\n\e[1;34m[+] VLESS XHTTP REALITY:\e[0m"
echo -e "\e[36m$xhttp_link\e[0m"

echo -e "\n\e[1;34m[+] VLESS gRPC REALITY:\e[0m"
echo -e "\e[36m$grpc_link\e[0m"

echo -e "\n\e[1;33m==================================================\e[0m"
echo "QR-код для VLESS XHTTP REALITY:"
echo "$xhttp_link" | qrencode -t ansiutf8
echo -e "\e[1;33m==========================================================================\e[0m"
echo "QR-код для VLESS gRPC REALITY:"
echo "$grpc_link" | qrencode -t ansiutf8
echo -e "\e[1;33m==========================================================================\e[0m"
EOF
chmod +x /usr/local/bin/link

systemctl restart xray

# Autoupdate-check (every 4 days)
(crontab -l 2>/dev/null | grep -v '# Xray-update'; echo "0 6 */4 * * bash -c \"\$(curl -fsSL https://github.com/XTLS/Xray-install/raw/main/install-release.sh)\" @ install > /dev/null 2>&1 # Xray-update") | crontab -

shutdown -r +15

echo -e "\n\e[1;33m==================================================\e[0m"
echo -e "\e[1;32m      XRAY INSTALLATION COMPLETE 🎭\e[0m"
echo -e "\e[1;33m==================================================\e[0m"
link
